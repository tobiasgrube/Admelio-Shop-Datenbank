CREATE DATABASE AdmelioShop;
GO
USE AdmelioShop;
GO

CREATE TABLE Artikel (
    ID INT IDENTITY PRIMARY KEY,
    Artikelbezeichnung NVARCHAR(255),
	Artikelgruppe NVARCHAR(255),
	Preis SMALLMONEY,
	Waehrung NCHAR(3),
	Vorraetig BIT
);

CREATE TABLE Kunden (
    ID INT IDENTITY PRIMARY KEY,
    Vorname NVARCHAR(100),
    Nachname NVARCHAR(50),
    Email NVARCHAR(100),
    Telefonnummer NVARCHAR(15),
    Strasse NVARCHAR(100),
    Hausnummer NCHAR(10),
    PLZ NVARCHAR(5),
    Ort NVARCHAR(100)
);

CREATE TABLE Bestellungen (
    ID INT IDENTITY PRIMARY KEY,
    ArtikelID INT,
    KundenID INT,
    Menge INT,
    Bestelldatum DATE,
    FOREIGN KEY (ArtikelID) REFERENCES Artikel(ID),  -- Foreign Key für ArtikelID
    FOREIGN KEY (KundenID) REFERENCES Kunden(ID)     -- Foreign Key für KundenID
);

