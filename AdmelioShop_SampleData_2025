/* ---------- Stammdaten ---------- */

CREATE TABLE dbo.Waehrung (
    Code NCHAR(3)  NOT NULL CONSTRAINT PK_Waehrung PRIMARY KEY,
    Name NVARCHAR(50) NOT NULL
);
INSERT INTO dbo.Waehrung(Code, Name) VALUES (N'EUR', N'Euro');

CREATE TABLE dbo.Artikelgruppe (
    ArtikelgruppeID INT IDENTITY CONSTRAINT PK_Artikelgruppe PRIMARY KEY,
    Name NVARCHAR(100) NOT NULL CONSTRAINT UQ_Artikelgruppe_Name UNIQUE
);

CREATE TABLE dbo.Artikel (
    ID INT IDENTITY CONSTRAINT PK_Artikel PRIMARY KEY,
    Artikelbezeichnung NVARCHAR(255) NOT NULL,
    ArtikelgruppeID INT NOT NULL
        CONSTRAINT FK_Artikel_Artikelgruppe REFERENCES dbo.Artikelgruppe(ArtikelgruppeID),
    Preis SMALLMONEY NOT NULL,
    WaehrungCode NCHAR(3) NOT NULL
        CONSTRAINT FK_Artikel_Waehrung REFERENCES dbo.Waehrung(Code),
    Vorraetig BIT NOT NULL
);
CREATE INDEX IX_Artikel_Gruppe ON dbo.Artikel(ArtikelgruppeID);

CREATE TABLE dbo.Kunden (
    ID INT IDENTITY CONSTRAINT PK_Kunden PRIMARY KEY,
    Vorname NVARCHAR(100) NOT NULL,
    Nachname NVARCHAR(50)  NOT NULL,
    Email NVARCHAR(100)    NOT NULL,
    Telefonnummer NVARCHAR(15) NULL,
    Strasse NVARCHAR(100)  NOT NULL,
    Hausnummer NCHAR(10)   NOT NULL,
    PLZ NVARCHAR(5)        NOT NULL,
    Ort NVARCHAR(100)      NOT NULL
);
CREATE INDEX IX_Kunden_Ort ON dbo.Kunden(Ort);

-- Bestellung = Kopf
CREATE TABLE dbo.Bestellungen (
    ID INT IDENTITY CONSTRAINT PK_Bestellungen PRIMARY KEY,
    KundenID INT NOT NULL
        CONSTRAINT FK_Bestellungen_Kunden REFERENCES dbo.Kunden(ID),
    Bestelldatum DATE NOT NULL,
    Status NVARCHAR(20) NOT NULL DEFAULT(N'Bezahlt') -- simpel gehalten
);
CREATE INDEX IX_Bestellungen_KundeDatum ON dbo.Bestellungen(KundenID, Bestelldatum);

-- Bestellpositionen = 1..n
CREATE TABLE dbo.Bestellpositionen (
    ID INT IDENTITY CONSTRAINT PK_Bestellpositionen PRIMARY KEY,
    BestellungID INT NOT NULL
        CONSTRAINT FK_Bestellpositionen_Bestellungen REFERENCES dbo.Bestellungen(ID),
    ArtikelID INT NOT NULL
        CONSTRAINT FK_Bestellpositionen_Artikel REFERENCES dbo.Artikel(ID),
    Menge INT NOT NULL CONSTRAINT CK_Bestellpositionen_Menge CHECK (Menge > 0),
    Einzelpreis SMALLMONEY NOT NULL,         -- Preis-Snapshot
    WaehrungCode NCHAR(3) NOT NULL
        CONSTRAINT FK_Bestellpositionen_Waehrung REFERENCES dbo.Waehrung(Code)
);
CREATE INDEX IX_Bestellpositionen_Bestellung ON dbo.Bestellpositionen(BestellungID);
CREATE INDEX IX_Bestellpositionen_Artikel ON dbo.Bestellpositionen(ArtikelID);

