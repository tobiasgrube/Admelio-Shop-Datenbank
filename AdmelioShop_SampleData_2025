/* ---------- Bestellungen der letzten 3 Jahre ---------- */

DECLARE @Heute DATE = CAST(GETDATE() AS DATE);
DECLARE @Start DATE = DATEADD(YEAR, -3, @Heute);   -- genau letzte 3 Jahre
DECLARE @Days  INT  = DATEDIFF(DAY, @Start, @Heute);
DECLARE @Orders INT = 300;                          -- Anzahl Bestellungen (voller, aber moderat)

-- Tally 1..N
;WITH Tally AS (
  SELECT TOP (@Orders) ROW_NUMBER() OVER (ORDER BY (SELECT NULL)) AS n
  FROM sys.all_objects
),
Orders AS (
  -- verteilt die Bestelldaten über die letzten 3 Jahre deterministisch
  SELECT 
    n,
    KundenID   = ((n - 1) % (SELECT COUNT(*) FROM dbo.Kunden)) + 1,
    Bestelldatum = DATEADD(DAY, (n % NULLIF(@Days,0)), @Start),
    Status = CASE (n % 4)
               WHEN 0 THEN N'Bezahlt'
               WHEN 1 THEN N'Versendet'
               WHEN 2 THEN N'Bezahlt'
               ELSE N'Erstellt'
             END
  FROM Tally
)
INSERT INTO dbo.Bestellungen (KundenID, Bestelldatum, Status)
SELECT KundenID, Bestelldatum, Status
FROM Orders
ORDER BY n;

-- Für jede Bestellung 1..5 Positionen (Mengen variieren 1..4), Artikel rotierend
;WITH B AS (
  SELECT ID, n = ROW_NUMBER() OVER (ORDER BY ID) 
  FROM dbo.Bestellungen
),
P AS (
  SELECT 
    BestellungID = B.ID,
    PosNum       = v.pos,
    ArtikelID    = ((B.n * 3 + v.pos) % (SELECT COUNT(*) FROM dbo.Artikel)) + 1,
    Menge        = ((B.n + v.pos) % 4) + 1  -- 1..4
  FROM B
  CROSS APPLY (VALUES (1), (2), (3), (4), (5)) AS v(pos)   -- bis zu 5 Positionen je Bestellung
  WHERE v.pos <= ((B.n % 5) + 1)                           -- 1..5 Positionen je Bestellung
)
INSERT INTO dbo.Bestellpositionen (BestellungID, ArtikelID, Menge, Einzelpreis, WaehrungCode)
SELECT 
  P.BestellungID,
  P.ArtikelID,
  P.Menge,
  A.Preis,           -- einfacher Preis-Snapshot (kein Verlauf)
  A.WaehrungCode
FROM P
JOIN dbo.Artikel A ON A.ID = P.ArtikelID;

